# Copy to .env.local for development. Never commit real values.
WORDPRESS_URL=http://localhost:8099            # internal WooCommerce URL (Store API). In k8s: http://wordpress:80
NEXT_PUBLIC_SITE_URL=http://localhost:3010     # canonical public URL (production: https://cosmetics.shomaaa.ir)
REVALIDATE_SECRET=change-me-min-16-chars       # protects POST /api/revalidate
NEWSLETTER_DIR=.data
INSECURE_COOKIES=1                             # dev/test over http only; never set in production
# DISABLE_RATE_LIMIT=1                         # automated test runs only

# AI product photography (scripts/generate-images.mjs)
OPENROUTER_API_KEY=                            # never commit
IMAGE_MODEL=google/gemini-nano-banana-2.1
